# Copy this file to .env and fill in the values. .env is git-ignored and is
# loaded automatically by trending_tracker/settings.py (via python-dotenv).
# Real environment variables always take precedence over this file.

# Required when DJANGO_DEBUG is False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# True for local development, False in production.
DJANGO_DEBUG=True

# Comma-separated hostnames the site may be served from. Leave empty for local
# development; required when DJANGO_DEBUG is False.
DJANGO_ALLOWED_HOSTS=
